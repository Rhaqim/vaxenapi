# ============================================================
# Vaxen API — Environment Variables
# ============================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# For Docker dev, DATABASE_URL is overridden in docker-compose.dev.yml
# ============================================================

# --- Server ---
PORT=8080
ENVIRONMENT=development  # development | production

# --- Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/vaxen?sslmode=disable

# --- JWT / Auth ---
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=168h  # 7 days

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Logging ---
LOG_LEVEL=info

# --- KYC Provider ---
KYC_PROVIDER=sumsub  # sumsub | onfido
SUMSUB_API_KEY=
SUMSUB_API_SECRET=
SUMSUB_BASE_URL=https://api.sumsub.com

# --- MFA Provider ---
MFA_PROVIDER=twilio  # twilio | totp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# --- Wallet / Key Management Provider ---
WALLET_PROVIDER=aws_kms  # aws_kms | fireblocks
AWS_REGION=us-east-1
AWS_KMS_KEY_POLICY=

# --- Exchange Provider ---
EXCHANGE_PROVIDER=internal  # internal | binance | kraken

# --- Payment Provider ---
PAYMENT_PROVIDER=circle  # circle | wise | stripe
CIRCLE_API_KEY=
CIRCLE_BASE_URL=https://api.circle.com

# --- Email Provider ---
EMAIL_PROVIDER=sendgrid  # sendgrid | smtp
EMAIL_FROM_ADDRESS=noreply@vaxen.io
EMAIL_FROM_NAME=Vaxen
SENDGRID_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=vaxen
