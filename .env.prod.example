# ============================================================
# Vaxen API — Production Environment Variables
# ============================================================
# Copy to .env.prod and fill in real values.
# NEVER commit this file to git.
# ============================================================

PORT=8080
ENVIRONMENT=production

DATABASE_URL=postgresql://vaxen_user:STRONG_PASSWORD@db:5432/vaxen?sslmode=require

JWT_SECRET=GENERATE_A_64_CHAR_RANDOM_STRING_HERE
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=168h

FRONTEND_URL=https://app.vaxen.io

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=STRONG_REDIS_PASSWORD

LOG_LEVEL=warn

KYC_PROVIDER=sumsub
SUMSUB_API_KEY=your-key
SUMSUB_API_SECRET=your-secret
SUMSUB_BASE_URL=https://api.sumsub.com

MFA_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-sid
TWILIO_AUTH_TOKEN=your-token
TWILIO_SERVICE_SID=your-service-sid

WALLET_PROVIDER=aws_kms
AWS_REGION=us-east-1
AWS_KMS_KEY_POLICY=

EXCHANGE_PROVIDER=internal

PAYMENT_PROVIDER=circle
CIRCLE_API_KEY=your-key
CIRCLE_BASE_URL=https://api.circle.com

EMAIL_PROVIDER=sendgrid
EMAIL_FROM_ADDRESS=noreply@vaxen.io
EMAIL_FROM_NAME=Vaxen
SENDGRID_API_KEY=your-key

POSTGRES_USER=vaxen_user
POSTGRES_PASSWORD=STRONG_PASSWORD
POSTGRES_DB=vaxen
